<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/**" />
    </imports>

    <services>
        <service id="webgriffe_sylius_fixtures.fixture.example_factory.product"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\ProductExampleFactory"
                 decorates="sylius.fixture.example_factory.product">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.product.inner" />
            <argument type="service" id="sylius.repository.shipping_category" />
            <argument type="service" id="sylius.repository.locale" />
            <argument type="service" id="sylius.generator.slug" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.shop_user"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\ShopUserExampleFactory"
                 decorates="sylius.fixture.example_factory.shop_user">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.shop_user.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.catalog_promotion"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\CatalogPromotionExampleFactory"
                 decorates="sylius.fixture.example_factory.catalog_promotion">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.catalog_promotion.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.promotion"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\PromotionExampleFactory"
                 decorates="sylius.fixture.example_factory.promotion">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.promotion.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.product_attribute"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\ProductAttributeExampleFactory"
                 decorates="sylius.fixture.example_factory.product_attribute">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.product_attribute.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.product_option"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\ProductOptionExampleFactory"
                 decorates="sylius.fixture.example_factory.product_option">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.product_option.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.taxon"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\TaxonExampleFactory"
                 decorates="sylius.fixture.example_factory.taxon">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.taxon.inner" />
            <argument type="service" id="sylius.factory.taxon_image" />
            <argument type="service" id="sylius.uploader.image" />
            <argument type="service" id="file_locator" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.example_factory.shipping_method"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\Factory\ShippingMethodExampleFactory"
                 decorates="sylius.fixture.example_factory.shipping_method">
            <argument type="service" id="webgriffe_sylius_fixtures.fixture.example_factory.shipping_method.inner" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.province"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\ProvinceFixture">
            <argument type="service" id="sylius.manager.province" />
            <argument type="service" id="sylius.repository.country" />
            <argument type="service" id="sylius.factory.province" />
            <tag name="sylius_fixtures.fixture" />
        </service>

        <service id="webgriffe_sylius_fixtures.fixture.price_history"
                 class="Webgriffe\SyliusFixturesPlugin\Fixture\PriceHistoryFixture">
            <argument type="service" id="sylius.manager.channel_pricing_log_entry" />
            <argument type="service" id="sylius.repository.product" />
            <argument type="service" id="sylius.repository.channel_pricing_log_entry" />
            <argument type="service" id="sylius.factory.channel_pricing_log_entry" />
            <argument type="service" id="sylius.processor.price_history.product_lowest_price_before_discount" />
            <tag name="sylius_fixtures.fixture" />
        </service>
    </services>
</container>
